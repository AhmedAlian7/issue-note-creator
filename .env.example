# Local Docker database, accessed from the host. Point this at Neon to run the
# app against the hosted database. Use the pooled host for the app and the
# direct host only for migrations.
DATABASE_URL=postgresql://issue_notes:local_dev_only@localhost:5432/issue_notes?schema=public
# Tests create and drop a throwaway database. Leave this on the local server so
# `pnpm test` never touches Neon. When empty, tests use DATABASE_URL.
DATABASE_URL_TEST=
SESSION_SECRET=
GROQ_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3
PARSE_MODEL=openai/gpt-oss-120b
# Empty uses localhost on the host and mailhog in Compose.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=warehouse@localhost.test
APP_BASE_URL=http://localhost:3000
TZ=Africa/Cairo
# Local development writes PDFs here. Leave empty in serverless production so
# PDFs are stored in PostgreSQL instead.
PDF_STORAGE_DIR=/data/pdfs

# Use fake only for deterministic voice-flow tests.
AI_PROVIDER=groq

# Production PDF renderer: playwright (local) or cloudflare (Browser Run REST).
PDF_RENDERER=playwright
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Free transactional email. When set, Resend is used instead of SMTP.
RESEND_API_KEY=

# Bearer secret for the GitHub Actions scheduled-report request.
CRON_SECRET=

# Dedicated bearer secret for GET /api/health, required by production Compose.
HEALTH_SECRET=
LOG_LEVEL=info
# Require an administrator to set the initial PIN when provisioning users.
REQUIRE_PROVISIONED_PIN=false

# docker-compose.prod.yml reads these from .env.prod. See docs/DEPLOY.md.
APP_DOMAIN=
POSTGRES_PASSWORD=

# Future integration only. Keep disabled. No WhatsApp requests are implemented.
WHATSAPP_BUSINESS_ENABLED=false
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_TEMPLATE_NAME=
WHATSAPP_BUSINESS_TEMPLATE_LANGUAGE=ar
