{
  "name": "issue-note-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.15.0 || ^24.0.0"
  },
  "scripts": {
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.0.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "^10.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
