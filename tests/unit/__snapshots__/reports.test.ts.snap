exports[`renders daily RTL email and export 1`] = `"<div lang="ar" dir="rtl" style="direction:rtl;text-align:right;font:16px Arial,sans-serif;color:#17383e"><h1>أذون الصرف الصادرة اليوم</h1><p>عدد الأذونات ١</p><h2 style="font-size:18px;color:#155a65">إذن رقم ١٠١ — <bdi dir="auto">&lt;عميل&gt;</bdi></h2><table dir="rtl" style="direction:rtl;border-collapse:collapse;width:100%;text-align:right"><thead><tr><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">الصنف</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">الكمية</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">ملاحظات</th></tr></thead><tbody><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right"><bdi dir="auto">كرسي</bdi></td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">٢</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right"><bdi dir="auto">القاهرة</bdi></td></tr><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right"><bdi dir="auto">كرسي</bdi></td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">٣</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right"><bdi dir="auto">القاهرة</bdi></td></tr></tbody></table></div>"`;

exports[`renders monthly RTL email and export 1`] = `"<div lang="ar" dir="rtl" style="direction:rtl;text-align:right;font:16px Arial,sans-serif;color:#17383e"><h1>التقرير الشهري</h1><p><span dir="ltr">2026-02-01 — 2026-02-02</span></p><p>عدد الأذونات 1 · إجمالي الوحدات 5</p><p>التغير عن الفترة السابقة · عدد الأذونات 1 · إجمالي الوحدات 5</p><p>اليوم الأكثر نشاطاً <span dir="ltr">2026-02-01</span></p><h2 style="font-size:18px;color:#155a65">الأذونات الصادرة</h2><table dir="rtl" style="direction:rtl;border-collapse:collapse;width:100%;text-align:right"><thead><tr><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">رقم</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">التاريخ</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">العميل</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">إجمالي الوحدات</th></tr></thead><tbody><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">101</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right"><span dir="ltr">2026-02-01</span></td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right"><bdi dir="auto">&lt;عميل&gt;</bdi></td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">5</td></tr></tbody></table><h2 style="font-size:18px;color:#155a65">الأصناف الأكثر صرفاً</h2><table dir="rtl" style="direction:rtl;border-collapse:collapse;width:100%;text-align:right"><thead><tr><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">الاسم</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">عدد الأذونات</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">إجمالي الوحدات</th></tr></thead><tbody><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">كرسي</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">1</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">5</td></tr></tbody></table><h2 style="font-size:18px;color:#155a65">ترتيب العملاء</h2><table dir="rtl" style="direction:rtl;border-collapse:collapse;width:100%;text-align:right"><thead><tr><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">الاسم</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">عدد الأذونات</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">إجمالي الوحدات</th></tr></thead><tbody><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">&lt;عميل&gt;</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">1</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">5</td></tr></tbody></table><h2 style="font-size:18px;color:#155a65">الأصناف الأبطأ حركة</h2><table dir="rtl" style="direction:rtl;border-collapse:collapse;width:100%;text-align:right"><thead><tr><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">الاسم</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">عدد الأذونات</th><th scope="col" align="right" style="padding:8px;background:#e5eeee;text-align:right">إجمالي الوحدات</th></tr></thead><tbody><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">مكتب</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">0</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">0</td></tr><tr><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">كرسي</td><td align="right" style="padding:8px;border-bottom:1px solid #ddd;text-align:right">1</td><td align="right" style